diff --git a/include/rex/graphics/vr_bridge.h b/include/rex/graphics/vr_bridge.h
new file mode 100644
index 0000000..a0796b8
--- /dev/null
+++ b/include/rex/graphics/vr_bridge.h
@@ -0,0 +1,95 @@
+/**
+ * @file        rex/graphics/vr_bridge.h
+ * @brief       Optional callbacks the D3D12 GPU plugin makes while a VR session is active
+ *
+ * @copyright   Copyright (c) 2026
+ * @license     BSD 3-Clause License — see LICENSE in the project root.
+ *
+ * The bridge is inert until a game calls SetBridge. Flat rendering does not
+ * consult it. Types are void* so this header does not include d3d12.h; the
+ * game and the D3D12 backend cast them to ID3D12Device, ID3D12CommandQueue
+ * and ID3D12Resource.
+ *
+ * One instance lives in rexruntime.dll. The GPU plugin and the game both call
+ * these functions, so the state is not an inline header static.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::vr {
+
+/// Packed vertex-shader float constants about to be uploaded for one draw.
+/// `values` is `count` float4s. `indices[i]` is the guest constant register
+/// (0-255) that float4 came from.
+struct VertexConstantSpan {
+  float* values = nullptr;
+  const uint16_t* indices = nullptr;
+  uint32_t count = 0;
+};
+
+/// Guest output image, after the frame's draws have been submitted to `queue`.
+/// `resource` is the presenter's UAV-capable texture in
+/// D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE (R10G10B10A2_UNORM). `fence` is
+/// the direct queue's submission fence, and `submission` is the value that
+/// queue has already been asked to signal for this frame (the signal is
+/// queued, not necessarily complete). The callback may record more commands
+/// on `queue`; it must put `resource` back in
+/// D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE before returning. It must not
+/// wait on the CPU for `fence`.
+struct PresentInfo {
+  void* device = nullptr;
+  void* command_queue = nullptr;
+  void* fence = nullptr;
+  void* resource = nullptr;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint64_t submission = 0;
+};
+
+/// What the presented image contains. The game sets this before the swap.
+enum class FrameLayout : uint32_t {
+  kMono = 0,       ///< Whole image, flat.
+  kSideBySide = 1, ///< Left eye in x=[0,width/2), right eye in the other half.
+  kAlternate = 2,  ///< Whole image is one eye; see SetEye.
+  kTheater = 3,    ///< Whole image, show it on a headset quad.
+};
+
+struct Bridge {
+  /// Return true to force the DXGI adapter. `min_feature_level` is a
+  /// D3D_FEATURE_LEVEL value (0xb000 = 11_0). Called before the device exists.
+  bool (*select_adapter)(uint32_t* luid_low, int32_t* luid_high, uint32_t* min_feature_level,
+                         void* userdata) = nullptr;
+
+  /// Device and direct queue are live. Create the OpenXR session here.
+  void (*on_d3d12_device)(void* device, void* queue, void* userdata) = nullptr;
+
+  /// Rewrite vertex-shader constants for this draw. Return true if any value
+  /// changed. Only called when PatchEveryDraw() is set.
+  bool (*patch_vertex_constants)(VertexConstantSpan span, uint32_t eye, void* userdata) = nullptr;
+
+  /// A guest frame was submitted to the direct queue. May be called on the
+  /// GPU thread.
+  void (*on_present)(const PresentInfo& info, void* userdata) = nullptr;
+
+  void* userdata = nullptr;
+};
+
+/// `bridge` must outlive the session. Pass null to clear. Safe to call before
+/// any GPU thread starts; afterwards only from the thread that presents.
+void SetBridge(const Bridge* bridge);
+const Bridge* GetBridge();
+
+void SetEye(uint32_t eye);
+uint32_t GetEye();
+
+void SetFrameLayout(FrameLayout layout);
+FrameLayout GetFrameLayout();
+
+/// When true, every draw re-uploads vertex float constants and calls
+/// patch_vertex_constants. Default false, which leaves the upload cache alone.
+void SetPatchEveryDraw(bool enabled);
+bool PatchEveryDraw();
+
+}  // namespace rex::graphics::vr
