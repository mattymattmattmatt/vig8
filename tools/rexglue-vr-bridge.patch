diff --git a/src/core/vr_bridge.cpp b/src/core/vr_bridge.cpp
new file mode 100644
index 0000000..05468c9
--- /dev/null
+++ b/src/core/vr_bridge.cpp
@@ -0,0 +1,55 @@
+/**
+ * @file        core/vr_bridge.cpp
+ * @brief       Process-wide VR bridge state, linked into rexruntime.dll
+ *
+ * @copyright   Copyright (c) 2026
+ * @license     BSD 3-Clause License — see LICENSE in the project root.
+ */
+
+#include <rex/graphics/vr_bridge.h>
+
+#include <atomic>
+
+namespace rex::graphics::vr {
+namespace {
+
+std::atomic<const Bridge*> g_bridge{nullptr};
+std::atomic<uint32_t> g_eye{0};
+std::atomic<uint32_t> g_layout{static_cast<uint32_t>(FrameLayout::kMono)};
+std::atomic<bool> g_patch{false};
+
+}  // namespace
+
+void SetBridge(const Bridge* bridge) {
+  g_bridge.store(bridge, std::memory_order_release);
+}
+
+const Bridge* GetBridge() {
+  return g_bridge.load(std::memory_order_acquire);
+}
+
+void SetEye(uint32_t eye) {
+  g_eye.store(eye, std::memory_order_release);
+}
+
+uint32_t GetEye() {
+  return g_eye.load(std::memory_order_acquire);
+}
+
+void SetFrameLayout(FrameLayout layout) {
+  g_layout.store(static_cast<uint32_t>(layout), std::memory_order_release);
+}
+
+FrameLayout GetFrameLayout() {
+  return static_cast<FrameLayout>(g_layout.load(std::memory_order_acquire));
+}
+
+void SetPatchEveryDraw(bool enabled) {
+  g_patch.store(enabled, std::memory_order_release);
+}
+
+bool PatchEveryDraw() {
+  return g_patch.load(std::memory_order_acquire);
+}
+
+}  // namespace rex::graphics::vr
